NESSIE_API_KEY=your_nessie_api_key_here
NESSIE_BASE_URL=https://api.nessieisreal.com
USE_MOCK_DATA=false

# Local SQLite database (file lives in backend/prisma/)
DATABASE_URL="file:./dev.db"

# --- Live market data (Alpha Vantage): https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# --- Ori's language model (Google Gemini). Authenticates by x-goog-api-key header.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ENABLED=true

# --- Live flight search (SerpApi google_flights): https://serpapi.com/manage-api-key
SERPAPI_KEY=

# --- MongoDB Atlas cluster URI (mongodb+srv://user:pass@cluster/...)
MONGODB_URI=
MONGODB_DB=orbit
